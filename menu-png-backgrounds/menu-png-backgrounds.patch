+#ifdef RT_DX12
+// Optional full-colour replacement for the menu frame background: put
+// scoresb.png (high-res) or scores.png in the game folder. Shown as-is, without
+// the 256-colour palette remap the PCX goes through. Either name is used if the
+// preferred one is missing; with neither, the original PCX is used.
+static char *nm_background_png(void)
+{
+	char *first = HIRESMODE ? "scoresb.png" : "scores.png";
+	char *second = HIRESMODE ? "scores.png" : "scoresb.png";
+	if (PHYSFSX_exists(first, 1))
+		return first;
+	if (PHYSFSX_exists(second, 1))
+		return second;
+	return NULL;
+}
+
+// Optional per-shape frame backgrounds. Menus come in very different shapes,
+// so instead of cropping one big image, each menu box is filled with the
+// variant whose shape (width/height) is closest, stretched to fit. Any subset
+// may be present; with none, the single background above is used.
+static const char *const nm_variant_names[] = {
+	"scoresb-tall.png", "scoresb-square.png", "scoresb-std.png", "scoresb-wide.png", "scoresb-strip.png"
+};
+#define NM_VARIANT_COUNT (sizeof(nm_variant_names) / sizeof(nm_variant_names[0]))
+static grs_bitmap nm_variants[NM_VARIANT_COUNT];
+static int nm_variants_loaded = 0;
+static int nm_variant_count = 0;
+
+static grs_bitmap *nm_pick_variant(int w, int h)
+{
+	int i, best = -1;
+	float best_diff = 0.0f;
+	if (!nm_variants_loaded)
+	{
+		ubyte palette[768];
+		nm_variants_loaded = 1;
+		for (i = 0; i < (int)NM_VARIANT_COUNT; i++)
+		{
+			gr_init_bitmap_data(&nm_variants[i]);
+			if (!PHYSFSX_exists(nm_variant_names[i], 1) ||
+				pcx_read_bitmap((char *)nm_variant_names[i], &nm_variants[i], BM_LINEAR, palette) != PCX_ERROR_NONE)
+				gr_init_bitmap_data(&nm_variants[i]);
+			else
+				nm_variant_count++;
+		}
+	}
+	if (nm_variant_count == 0 || w <= 0 || h <= 0)
+		return NULL;
+	for (i = 0; i < (int)NM_VARIANT_COUNT; i++)
+	{
+		if (!nm_variants[i].bm_data || nm_variants[i].bm_h <= 0)
+			continue;
+		{
+			// Compare shapes on a log scale so 2:1 vs 1:1 counts the same as 1:1 vs 1:2.
+			const float diff = (float)fabs(log(((double)w / h) / ((double)nm_variants[i].bm_w / nm_variants[i].bm_h)));
+			if (best < 0 || diff < best_diff)
+			{
+				best = i;
+				best_diff = diff;
+			}
+		}
+	}
+	return best >= 0 ? &nm_variants[best] : NULL;
+}
+#endif
